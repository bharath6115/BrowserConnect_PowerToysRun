<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <AssemblyName>Community.PowerToys.Run.Plugin.BrowserConnect</AssemblyName>
    <RootNamespace>Community.PowerToys.Run.Plugin.BrowserConnect</RootNamespace>
    
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>

  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Community.PowerToys.Run.Plugin.BrowserConnect.Tests\**\*.cs" />
    <EmbeddedResource Remove="Community.PowerToys.Run.Plugin.BrowserConnect.Tests\**\*" />
    <None Remove="Community.PowerToys.Run.Plugin.BrowserConnect.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- PowerToys Run plugin references -->
    <!-- Try multiple locations where these DLLs might be found -->
    <Reference Include="Wox.Plugin">
      <HintPath Condition="Exists('libs\Wox.Plugin.dll')">libs\Wox.Plugin.dll</HintPath>
      <HintPath Condition="Exists('$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\Wox.Plugin.dll')">$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\Wox.Plugin.dll</HintPath>
      <HintPath Condition="Exists('$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\*\Wox.Plugin.dll')">$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\*\Wox.Plugin.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="PowerToys.Settings.UI.Lib">
      <HintPath>libs\PowerToys.Settings.UI.Lib.dll</HintPath>
      <SpecificVersion>False</SpecificVersion>
      <Private>True</Private>
    </Reference>
    <Reference Include="Wox.Infrastructure">
      <HintPath Condition="Exists('libs\Wox.Infrastructure.dll')">libs\Wox.Infrastructure.dll</HintPath>
      <HintPath Condition="Exists('$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\Wox.Infrastructure.dll')">$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\Wox.Infrastructure.dll</HintPath>
      <HintPath Condition="Exists('$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\*\Wox.Infrastructure.dll')">$(LOCALAPPDATA)\Microsoft\PowerToys\PowerToys Run\Plugins\*\Wox.Infrastructure.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Images\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
